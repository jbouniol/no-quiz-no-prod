# No-Quiz-No-Prod: environment template.
# Copy this file to `.env` (gitignored) and fill in your own values. Never commit real keys.
# Keep secrets (NOTION_API_KEY, NO_QUIZ_GITHUB_TOKEN) in `.env` rather than exporting them in your shell: spawned MCP
# servers never receive secrets in their launch environment and read `.env` directly at runtime.

# --- LLM providers ------------------------------------------------------------------------------
# OpenRouter (default route): any model id containing "/" (DeepSeek, OpenAI, or Claude via OpenRouter).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest
# Optional override of the OpenAI-compatible endpoint:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Native Anthropic: used for "claude-*" model ids without "/" (or when provider="anthropic").
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Notion (Engineering Rules, Feature Ship Log, Developer Skill Profile) ------------------------
# Database ids fall back to docs/notion_workspace_ids.json when left empty.
NOTION_API_KEY=
NOTION_SHIP_LOG_DB_ID=
NOTION_RULES_DB_ID=
NOTION_SKILLS_DB_ID=

# --- Runtime ------------------------------------------------------------------------------------
# Disposable prod/ + staging/ workspace and SQLite state/gate ledger (relative paths resolve from the repository root).
NO_QUIZ_WORKSPACE_DIR=.runtime_workspace

# --- Git release (deploy_to_production commits and pushes, fast-forward only) -------------------------------------
# Empty: a local bare repository at <workspace>/release_remote.git. GitHub option: an https:// URL WITHOUT credentials,
# e.g. https://github.com/<owner>/<repo>.git, plus a token with contents:write on that repository only.
NO_QUIZ_GIT_REMOTE_URL=
NO_QUIZ_GIT_BRANCH=main
NO_QUIZ_GITHUB_TOKEN=
# The token is only ever sent to github.com. Add other HTTPS hosts here, comma-separated (e.g. a GitHub Enterprise
# host); a remote on any other host is refused before anything is pushed.
# NO_QUIZ_GIT_ALLOWED_HOSTS=

# --- Test sandbox -------------------------------------------------------------------------------------------------
# Agent-written tests run in an OS sandbox (sandbox-exec on macOS, bubblewrap on Linux). Without one, the test run is
# refused. Setting this to 1 runs them with NO isolation: they can then read and write whatever your user can.
# Unsafe; it is shown in the gate status. Leave it unset.
# NO_QUIZ_UNSAFE_NO_SANDBOX=

# --- Web Studio ---------------------------------------------------------------------------------------------------
# The Studio only answers requests whose Host header is a loopback name or the --host it was started with. Add other
# names here, comma-separated (same as `no-quiz-ui --allowed-host`, and the form to use with --reload).
# NO_QUIZ_UI_ALLOWED_HOSTS=
